project p {

	context x {

		namespace types {
			type UUID
			type String
			type Integer
		}

		namespace cmd {

			import p.x.types.*

			aggregate-id CustomerId identifies Customer base UUID {
				examples "42705de0-91a1-11e4-b4a9-0800200c9a6"
			}

			aggregate Customer identifier CustomerId {

				/** Renames the customer. */
				method rename {

					/** The new name. */
					String newName

				}

			}

			value-object MyString base String {
				examples "abc" "def"
				String value
			}

			/** Command A - No attributes at all. */
			command CommandA {
				message "Command A"
			}

			/** Command B - One mandatory attribute, which has to carry @NotNull. */
			command CommandB {
				/** A. */
				String a {
					examples "Abc"
				}
				message "Command B: ${a}"
			}

			/**
			 * Command C - A mandatory and an optional attribute side by side, so the two
			 * annotations can be told apart: mandatory gets @NotNull, optional gets @Nullable
			 * and neither gets both.
			 */
			command CommandC {
				/** A. */
				String a {
					examples "Abc"
				}
				/** B. */
				optional Integer b {
					examples 123
				}
				message "Command C: ${a} / ${b}"
			}

			/** Command D - Attributes are value objects rather than plain types. */
			command CommandD {

				/** Field A */
				MyString a

				/** Field B */
				optional MyString b {
					examples "123" "456"
				}

				message "Command D"
			}

			/**
			 * Command E - Targets an aggregate method, so its attributes are the method's
			 * parameters rather than its own. That is a different path through the generator.
			 */
			command CommandE target Customer.rename {
				message "Command E"
			}

			/**
			 * Command F - Targets an aggregate method and declares an attribute of its own on top, so
			 * both have to end up on the generated command: the method's parameters first, then the
			 * extra attribute.
			 */
			command CommandF target Customer.rename {

				/** Why the rename was requested. */
				String reason

				message "Command F: ${newName} because ${reason}"

			}

		}

	}

}
