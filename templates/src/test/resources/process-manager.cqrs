project p {

    context x {

        namespace m {

            type String
            type UUID

            aggregate-id UserId identifies User {}

            aggregate User identifier UserId {
                constructor create fires UserCreatedEvent {
                    String name
                    event UserCreatedEvent { message "created" }
                }
            }

            // Process-manager name deliberately ends in "Process" to exercise the suffix stripping.
            process-manager OrderPaymentProcess {
                cron-schedule "* * * * * *"
                correlation-id UUID
                process-states {
                    AWAITING
                    DONE
                }
                reacts-to User.create.UserCreatedEvent {
                    transition-to DONE
                }
            }

        }

    }

}
