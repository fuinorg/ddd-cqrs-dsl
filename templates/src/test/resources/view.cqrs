context p {

    module x.m {
        type String

        type Integer

        type List generics 1

        value-object PersonListItem {
            String name
        }

        aggregate-id UserId identifies User {}

        aggregate User identifier UserId {
            constructor create fires UserCreatedEvent {
                String name
                event UserCreatedEvent { message "created" }
            }
        }

        projection UserList input User.create.UserCreatedEvent

        // View name deliberately ends in "View" to exercise the suffix stripping.
        view PersonListView uses UserList rest-path "/persons" {
            cron-schedule "* * * * * *"

            /** Returns the persons matching the optional filter. */
            method listPersons rest-path "" {
                optional String search
                returns List<PersonListItem>
            }

            /** Returns a single person. */
            method findPerson rest-path "/{id}" {
                UserId id
                returns optional PersonListItem
            }

            /** Returns the number of persons - no explicit path, so the method name is used. */
            method countPersons {
                returns Integer
            }
        }
    }
}
