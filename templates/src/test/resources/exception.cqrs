context p {

	module x.types {
		type String
		type Integer
	}

	module x.except {
		import p.x.types.*

		/** Exception A - No variables */
		exception ExceptionA {
			message "Exception A"
		}

		/** Exception B - No variables */
		exception ExceptionB {
			message "Exception B"
		}

		/** Exception C - Single variable */
		exception ExceptionC {
			/** A. */
			String a
			message "Exception C: ${a}"
		}

		/** Exception D - Multiple variables */
		exception ExceptionD {
			/** A. */
			String a
			/** B. */
			Integer b
			message "Exception D: ${a} / ${b}"
		}

		/** Exception E - Single variable */
		exception ExceptionE {
			/** A. */
			String a
			message "Exception C: ${a}"
		}

		/** Exception F - Multiple variables */
		exception ExceptionF{
			/** A. */
			String a
			/** B. */
			Integer b
			message "Exception F: ${a} / ${b}"
		}
	}
}
