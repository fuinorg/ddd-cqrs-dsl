project p {

	context x {

		namespace types {
			type String
			type Integer
			type List generics 1
		}

		namespace services {

			import p.x.types.*

			/** The constraint was violated. */
			exception AnyConstraintViolatedException {
				message "Any constraint violated"
			}


			/** Service A - No methods. */
			service ServiceA {

			}

			/** Service B - Single method. */
			service ServiceB {

				/** Finds something. */
				method find {

					/** Key. */
					Integer a

					/** Value. */
					returns String

				}

			}

			/** Service C - Generic return type. */
			service ServiceC {

				/** Lists something. */
				method list {

					/** Key. */
					Integer a

					/** Values. */
					returns List<String>

				}

			}

		}

	}

}
