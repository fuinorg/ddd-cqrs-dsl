project p {

	context x {

		namespace types {
			type String
			type Integer
		}

		namespace aggregates {

			import p.x.types.*

			/** The constraint was violated. */
			exception AnyConstraintViolatedException {
				message "Any constraint violated"
			}

			aggregate-id AggregateAId identifies AggregateA {}

			/** Aggregate A. */
			aggregate AggregateA identifier AggregateAId {}

			aggregate-id AggregateBId identifies AggregateB {}

			/** Aggregate B - With variables. */
			aggregate AggregateB identifier AggregateBId {

				/** Variable A. */
				String a

				/** Variable B. */
				Integer b

			}

			/** The aggregate D was changed - declared here, not inside the method that fires it. */
			event AggregateDChangedEvent {

				/** Variable A. */
				String a

				message "Aggregate D was changed: ${a} [${entityIdPath}]"

			}

			aggregate-id AggregateDId identifies AggregateD {}

			/** Aggregate D - Fires an event declared outside the method. */
			aggregate AggregateD identifier AggregateDId {

				/** Changes something. */
				method change fires AggregateDChangedEvent {

					/** Variable A. */
					String a

				}

			}

			aggregate-id AggregateCId identifies AggregateC {}

			/** Aggregate C - With constructor, constraint and event. */
			aggregate AggregateC identifier AggregateCId {

				/** Variable A. */
				String a

				/** Variable B. */
				Integer b

				/** Checks something. */
				business-rule AnyConstraint exception AnyConstraintViolatedException {

					/** Explain why it's strict. */
					consistency strong

				}

				/** Creates the entity. */			
				constructor create business-rules AnyConstraint fires AggregateCCreatedEvent {

					/** Variable A. */
					String a

					/** Variable B. */
					Integer b

					/** The aggregate C was created. */
					event AggregateCCreatedEvent {

						/** Variable A. */
						String a

						/** Variable B. */
						Integer b

						message "Aggregate C was created: ${a} / ${b} [${entityIdPath}]"

					}

				}

			}

		}

	}

}
