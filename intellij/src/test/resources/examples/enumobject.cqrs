context p_enumobject {

	module x.types {
		type String
		type Integer
		type Boolean
	}

	module x.enumobject {
		import p_enumobject.x.types.*

		enum EnumA {
			instances {
				A {
					slabel "1st"
					label "First one"
					tooltip "The first instance"
					prompt "a"
					examples "A" "AA"
				}
				B {
					label "Second one"
				}
				C
			}
		}

		enum EnumB {
			Integer id
			String shortName
			String longName

			instances {
				A(1, "a", "First") {
					slabel "1st"
					label "First one"
				}
				B(2, "b", "Second")
				C(3, "c", "Third")
			}
		}

		enum EnumC {
			instances {
				A
				deprecated B
				C
			}
		}

		enum EnumD base Integer {
			Integer id

			instances {
				A(1)
				B(2)
				C(3)
			}
		}
	}
}
