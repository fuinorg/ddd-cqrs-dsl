context p_service {

	module x.types {
		type String
		type Integer
		type List generics 1
	}

	module x.services {
		import p_service.x.types.*

		exception AnyConstraintViolatedException {
			message "Any constraint violated"
		}

		service ServiceA {
		}

		service ServiceB {
			method find {
				Integer a
				returns String
			}
		}

		service ServiceC {
			method list {
				Integer a
				returns List<String>
			}
		}

		service ServiceD {
			method find {
				Integer a
				returns optional String
			}
			method list {
				Integer a
				returns optional List<String>
			}
		}
	}
}
