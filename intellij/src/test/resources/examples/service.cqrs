project p_service {

	context x {
		namespace types {
			type String
			type Integer
			type List generics 1
		}

		namespace services {
			import x.types.*

			exception AnyConstraintViolatedException {
				message "Any constraint violated"
			}

			service ServiceA {
			}

			service ServiceB {
				method find {
					Integer a
					returns String
				}
			}

			service ServiceC {
				method list {
					Integer a
					returns List<String>
				}
			}

			service ServiceD {
				method find {
					Integer a
					returns optional String
				}
				method list {
					Integer a
					returns optional List<String>
				}
			}
		}
	}

}
