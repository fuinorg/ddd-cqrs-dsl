project p_context_mixed {

	context x {

		import p_context_mixed.other.*

		type String

		value-object DirectValueObject base String {
			String value
		}

		namespace inner {
			import x.other.*

			type Integer

			value-object NamespacedValueObject {
				Integer id
			}
		}

		value-object AnotherDirectValueObject {
			String id
		}

	}

}
