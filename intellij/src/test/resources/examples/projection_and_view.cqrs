context p_projection_and_view {

	module x.types {
		type String
		type UUID
	}

	// A module may carry UI meta information, so a client knows what to call it.
	module x.readmodel {

		slabel "Users"
		label "User read model"
		tooltip "Everything readable about users"

		import p_projection_and_view.x.types.*

		exception UnknownUserException {
			message "Unknown user"
		}

		aggregate-id UserId identifies User base UUID {
			examples "6bc75dd5-be5b-4c57-977e-8ee404b21c74"
		}

		aggregate User identifier UserId {
			constructor create fires UserCreatedEvent {
				String name
				event UserCreatedEvent { message "created" }
			}
		}

		// A projection may consume one or more events ...
		projection UserList input User.create.UserCreatedEvent

		// ... or none at all: the input is optional.
		projection EmptyList

		// A view with an empty body.
		view EmptyView uses EmptyList {
		}

		// A view may declare business rules and methods, like a service.
		// It may also set an optional REST base path and projection cron.
		view UserListView uses UserList rest-path "/users" {

			// A view carries UI meta information too - it comes before the hints.
			slabel "Users"
			label "User list"
			tooltip "All known users"

			// A view may carry generator hints, like a project.
			hint SrcGen4J { "folder": "genMainJava" }

			cron-schedule "* * * * * *"

			business-rule UserKnown exception UnknownUserException {
				consistency strong
			}

			// A method may set its own REST sub path; without it the method name is used.
			method findName business-rules UserKnown rest-path "/{id}/name" {
				UserId id
				returns String
			}

			// A method carries it as well, written before its parameters.
			method countUsers {

				slabel "Count"
				label "Number of users"

				returns UUID
			}

		}
	}
}
