# General
.*
!.gitignore
!.gitkeep
!.github
*.log

# Maven
!.mvn
target
# JDT output folder of the test projects - the directory itself, not just its contents,
# so nothing inside it can be added by accident again.
test-bin/

# Eclipse
!.classpath
!.project
!.launch
!.settings
bin

# Classpath dumps from `dependency:build-classpath` (see architectural-hints.md) - machine-local
# absolute paths into ~/.m2, regenerate them instead of committing them.
cp*.txt

# Eclipse headless build outputs (see eclipse-build/)
eclipse-build/work/
eclipse-build/repository/
eclipse-build/test-results/
# Keep the env template tracked (the real .env stays ignored by the .* rule above)
!eclipse-build/.env.example

# Others
/templates/src/main/generated-sources/
/templates/src/test/resources/.project
/dsl-examples/.project
/dsl-examples/dsl-examples.iml
