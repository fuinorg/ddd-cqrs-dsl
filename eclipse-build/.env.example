# Local credentials for ./publish.sh -- copy to "eclipse-build/.env" and fill in.
# eclipse-build/.env is git-ignored (the repo .gitignore ignores all dotfiles).
# In GitHub Actions these come from a repo variable (P2_USER) and secret (P2_TOKEN).

# Artifactory user and token for https://fuinorg.jfrog.io/artifactory/ddd-cqrs-dsl
P2_USER=admin
P2_TOKEN=

# Optional overrides (defaults shown):
# ARTIFACTORY_BASE=https://fuinorg.jfrog.io/artifactory/ddd-cqrs-dsl
# ARTIFACTORY_PATH=cqrs-dsl
