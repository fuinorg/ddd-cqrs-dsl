project p_01_context_mixed {

	// A context may MIX namespace blocks and type/elements as siblings. Imports come
	// first, then namespaces and elements in any order. Elements declared directly in
	// the context land in the "project.context" package (no namespace segment); elements
	// inside a namespace land in "project.context.namespace".
	context shop {

		import p_01_context_mixed.shop.catalog.*   // imports are still declared first

		// A type declared directly in the context, alongside the namespace below.
		type String

		value-object DirectName base String {
			String value
		}

		// A namespace sibling of the elements above - both are allowed in one context.
		namespace catalog {
			type Integer

			value-object ProductNumber {
				Integer value
			}
		}

		// And another element after the namespace, to show free interleaving.
		value-object AnotherDirectName base String {
			String value
		}

	}

}
