// An aggregate is a consistency boundary identified by an aggregate-id.
//   'identifies' links the id to its aggregate
//   'identifier' links the aggregate to its id
// A constructor can 'fire' domain events (declared inline here).
context orders {
	namespace m {
		type String
		type UUID

		aggregate-id OrderId identifies Order base UUID {
			examples "6bc75dd5-be5b-4c57-977e-8ee404b21c74"
		}

		aggregate Order identifier OrderId {

			String customer

			constructor create fires OrderCreatedEvent {
				String customer
				event OrderCreatedEvent {
					String customer
					message "Order created for ${customer}"
				}
			}
		}
	}
}
