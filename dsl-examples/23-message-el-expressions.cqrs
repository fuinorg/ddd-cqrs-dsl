context p_23_message_el_expressions {

    module orders.m {
        type String
        type Integer
        type BigDecimal

        aggregate-id OrderId identifies Order {}

        aggregate Order identifier OrderId {

            // An EVENT message is evaluated with Jakarta EL (KeyValueEL) on the JVM, so a ${...}
            // placeholder may be a simple variable OR a full EL expression (method call, arithmetic).
            // A COMMAND message may not - see the command at the bottom of this file.

            // Event message mixing a simple ${customer} variable with an EL method call
            // ${customer.toUpperCase()}, plus the implicit ${entityIdPath}.
            constructor place fires OrderPlacedEvent {

                String customer
                BigDecimal amount

                event OrderPlacedEvent copies-attributes-of place {
                    message "Order placed by ${customer} (${customer.toUpperCase()}) total ${amount} [${entityIdPath}]"
                }

            }

            // Event message using an EL arithmetic expression.
            event OrderRepricedEvent {
                Integer quantity
                BigDecimal price
                message "Repriced: ${quantity} x ${price} = ${quantity * price}"
            }

        }

        // A command message is stricter than an event's: plain variables and dotted paths only.
        // It is a confirmation prompt shown before the command is sent, so the client renders it too,
        // and a client without an expression language cannot evaluate ${amount.doubleValue()}.
        // Allowing EL here would mean the two renderers disagree about the same message.
        command PlaceOrder target Order.place sla 2 seconds {

            String customer
            BigDecimal amount

            message "Place order for ${customer} worth ${amount}"

        }

        command-handler OrderHandler handles PlaceOrder uses Order
    }
}
