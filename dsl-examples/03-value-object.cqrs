context p_03_value_object {

    module vo.m {
        type String
        type Integer

        // A value-object has no identity;
        // it is defined only by its attributes.

        // Restricts a single primitive type to some additional rules.
        // Is only allowed to have a single attribute with the same type as defined for 'base'.
        // Not allowed to define a constructor or methods.
        value-object EmailAddress base String {
            String value
        }

        // Groups several attributes (has no 'base' type).
        value-object Money {

            Integer amount
            String currency

        }

    }

}
