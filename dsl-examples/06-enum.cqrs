// An enum has a fixed set of named instances.
//   - instances may carry parameters (when the enum declares attributes)
//   - an instance can be marked 'deprecated'
//   - an enum may have a 'base' external type
context enums {
	namespace m {
		type String
		type Integer

		// Simplest form: just names
		enum Color {
			instances {
				RED
				GREEN
				deprecated BLUE
			}
		}

		// With attributes -> each instance provides values
		enum Priority base Integer {
			Integer code
			String title

			instances {
				LOW(1, "low")
				HIGH(2, "high")
			}
		}
	}
}
