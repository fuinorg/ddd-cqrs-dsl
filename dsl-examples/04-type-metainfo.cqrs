context p_04_type_metainfo {

    // The same block attaches to a module, and it is the only place a user interface can learn what
    // to call one: a module name is a single lowercase identifier, so "businesspartners" cannot be
    // turned into "Business partners" by any rule a client could write.
    module meta.m {

        slabel "Meta"                            // For a tab or a bottom bar, where space is tight
        label "Meta data"                        // For a menu or a navigation rail
        tooltip "Demonstrates the UI meta data"  // To explain the module where it is offered

        type String
        type Integer

        value-object FullName {

            // UI metadata can be attached to a type and overridden per attribute.

            slabel "Name"                        // Abbreviation label to be shown in the UI
            label "Full name"                    // Label to be shown in a UI
            tooltip "A person's full name"       // Tooltipp to be shown in a UI
            examples "Peter Parker" "Mary Jane"  // Examples that may be used for test code or in UI

            String first {
                label "First name"               // Overrides the label defined above
                prompt "Enter your first name"   // Defines a prompt just for this field
                examples "Peter"                 // Overrides examples from above
            }

            String last                          // Inherits meta data from above

        }

        // The same block attaches to an enum instance - see 06-enum.cqrs.

        projection FullNames

        // A view and each of its methods carry it too, so a screen and its tabs can be captioned
        // from the model rather than from the type name.
        view FullNameView uses FullNames {

            slabel "Names"
            label "Full names"
            tooltip "Everybody recorded here"

            method countNames {

                slabel "Count"
                label "Number of names"
                tooltip "How many people are recorded"

                returns Integer
            }

        }

    }
}
