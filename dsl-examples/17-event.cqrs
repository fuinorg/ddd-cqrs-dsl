// A domain event records something that happened. It carries attributes and a
// message template, and can copy the attributes of a constructor/method with
// 'copies-attributes-of'.
context events {
	namespace m {
		type String

		aggregate-id UserId identifies User {}
		aggregate User identifier UserId {

			constructor register fires UserRegisteredEvent {
				String email
				// copies the 'email' attribute from the 'register' constructor
				event UserRegisteredEvent copies-attributes-of register {
					message "User ${email} registered"
				}
			}

			// a standalone event with its own attributes
			event UserRenamedEvent {
				String oldName
				String newName
				message "Renamed ${oldName} to ${newName}"
			}
		}
	}
}
