project p_15_method {

	context behavior {

		namespace m {

			type String
			type Boolean

			constraint NotBlank input String { message "Blank" }

			aggregate-id DocId identifies Doc {}

			aggregate Doc identifier DocId {

	            /**
	             * Renames the document.
	             */
				method rename fires RenamedEvent {

					// Parameters with (optional) preconditions
					String newName preconditions NotBlank

	                // Inline defined event(s) to be fired on success 
					event RenamedEvent {
						String newName
						message "Renamed to ${newName}"
					}

					// Does not return anything

				}

				// It's a function as it 'returns' a type
				method isEmpty {
					returns Boolean
				}

				// A 'ref' link to another method means it has exactly the same arguments
				method forceRename ref rename {
					// Does not return anything
				}

			}

		}

	}

}
