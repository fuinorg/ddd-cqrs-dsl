context p_13_business_rule_consistency {

    module banking.m {
        import p_13_business_rule_consistency.common.rules.*

        type String

        exception OverdrawnException { message "Overdrawn" }

        exception StaleException { message "Stale" }

        aggregate-id AccountId identifies Account {}

        aggregate Account identifier AccountId {

            // A business-rule is a checked condition tied to an exception and a consistency
            // level. A doc comment (/** ... */) is required directly before it.
            // Rules are applied to constructors/methods via 'business-rules' (with optional
            // parameters).

            /** The balance must never go negative. */
            business-rule NotOverdrawn exception OverdrawnException {

                // A 'strong' consistency means the rule may never be violated.
                consistency strong
            }

            /** A read model may lag behind for a short while. */
            business-rule EventuallyConsistent exception StaleException {

                // A 'weak' consistency means a temporary violation is allowed.
                // 'acceptable' amount defines after what time the problem must be solved.
                // 'detection' describes how the problem will be detected ('automatic', 'manually' or 'never').
                // 'resolution' describes how it will be solved ('automatic', 'manually', 'workflow' or 'never').
                consistency weak {
                    acceptable 5 minutes
                    detection automatic
                    resolution workflow
                }
            }

            method withdraw business-rules NotOverdrawn, EntityMustNotBeDeletedRule {
            }

        }
    }

    // A rule that means the same thing in every aggregate is declared once, at module level, and
    // imported like any other type. Only the placement differs - the syntax is identical, and an
    // aggregate may still declare its own rules alongside the ones it imports.
    module common.rules {
        type String

        exception InStateDeletedException { message "Already deleted" }

        /** Makes sure the entity was not (soft) deleted yet. */
        business-rule EntityMustNotBeDeletedRule exception InStateDeletedException {
            consistency strong
        }
    }
}
