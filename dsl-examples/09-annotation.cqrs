project p_09_annotation {

	context anno {

		namespace m {

			type String
			type Integer

			annotation Encrypted {
			}

	        // It can be declared with attributes.
			annotation MaxLength {
				Integer value
			}

	        // It may be applied to a value-object or event
			@Encrypted
			@MaxLength(50)
			value-object Secret base String {
				String value
			}

		}

	}

}
