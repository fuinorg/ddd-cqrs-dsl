context p_05_attributes_and_generics {

    module attrs.m {
        type String
        type Integer
        type List generics 1
        type Map generics 2

        value-object Profile {

            String name                   // Required by default

            optional Integer age          // Makes the attribute optional

            List<String> tags             // Generic with one argument

            Map<String, Integer> scores   // Generic with two arguments

        }
    }
}
