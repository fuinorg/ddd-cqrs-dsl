project p_14_constructor {

	context ctor {

		namespace m {

			type String
			type Integer

			aggregate-id ItemId identifies Item {}

			aggregate Item identifier ItemId {

				// A constructor creates an aggregate/entity.
				constructor create fires ItemCreatedEvent {

					// Parameters
					String name

					optional Integer quantity

	                // Inline defined event(s) to be fired on success 
					event ItemCreatedEvent {
						String name
						message "Item ${name} created"
					}

				}

			}

		}

	}

}
