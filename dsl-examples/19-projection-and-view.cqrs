project p_19_projection_and_view {

	context readmodel {

		namespace m {

			type String

			aggregate-id UserId identifies User {}

			aggregate User identifier UserId {
				constructor create fires UserCreatedEvent {
					String name
					event UserCreatedEvent { message "created" }
				}
			}

			// A projection consumes one or more events to build a read model.
			// The events are optional: a projection may also be declared without any input.
			projection UserList input User.create.UserCreatedEvent

			exception UnknownUserException { message "Unknown user" }

			// A view is the result produced by a projection. Like a service it may declare
			// business rules and methods to query it - the body may also be left empty.
			view UserListView uses UserList {

				// Optional: REST base path for the generated controller (else derived
				// from the aggregate name) and the projection cron (else "* * * * * *").
				rest-path "/users"
				cron-schedule "* * * * * *"

				/** The requested user must exist in the read model. */
				business-rule UserKnown exception UnknownUserException {
					consistency strong
				}

				/** Returns the name of a single user. */
				method findName business-rules UserKnown {
					UserId id
					returns String
				}

			}

		}

	}

}
