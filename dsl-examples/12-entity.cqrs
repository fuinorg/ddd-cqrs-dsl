project p_12_entity {

	context inventory {

		namespace m {

			type String

			aggregate-id BasketId identifies Basket {}

			aggregate Basket identifier BasketId {}

	        // entity-id works like aggregate-id.
			entity-id LineItemId identifies LineItem {}

	        // An entity has identity but lives inside an aggregate.
	        // The 'root' points to the owning aggregate.
			entity LineItem identifier LineItemId root Basket {
				String product
			}

		}

	}

}
