context p_18_command_and_handler {

    module commands.m {
        type String

        aggregate-id TaskId identifies Task {}

        aggregate Task identifier TaskId {
            constructor create fires CreatedEvent {
                String title
                event CreatedEvent {
                    message "created"
                }
            }
        }

        // An immutable object that represents a user's intent to mutate the system's state.
        // It may target an aggregate's method which should be executed.
        // The 'sla' defines a 'service level agreement', e.g. the maximum time between receiving
        // the command and returning after executing it.

        /**
         * Creates a task using the 'create' constructor of the 'Task' aggregate.
         */
        command CreateTask target Task.create sla 2 seconds {

            // A command carries its own wording, like every other named element except an event: a
            // client shows 'slabel' where space is tight (a menu entry, a button), 'label' where
            // there is room (a dialog title) and 'tooltip' on hover. Without it a client has
            // nothing to put on a button but the sentence-long documentation above.
            slabel "New task"
            label "Create a task"
            tooltip "Adds a task to the list"

            String title

            message "Create a new task"

        }

        // A stateless worker that handles on one or more specific commands and executes
        // some application logic to complete the request. The handler can be independent
        // of agggreates or use to one or more aggregates.

        /**
         * Handles the create task command using the Task aggregate.
         */
        command-handler TaskHandler handles CreateTask uses Task
    }
}
