{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://www.fuin.org/dsl/cqrs/schema/jpa-hint.schema.json",
	"title": "JpaHint",
	"description": "Describes one or more JPA tables generated for the enclosing view. The generated classes end up in the view's package, so there is no 'package' key.",
	"type": "object",
	"additionalProperties": false,
	"required": [ "tables" ],
	"properties": {
		"tables": {
			"type": "array",
			"items": { "$ref": "#/$defs/table" }
		}
	},
	"$defs": {
		"table": {
			"type": "object",
			"additionalProperties": false,
			"required": [ "className", "columns" ],
			"properties": {
				"className": { "type": "string", "minLength": 1, "description": "Name of the generated Java class." },
				"name": { "type": "string", "description": "@Table 'name'." },
				"catalog": { "type": "string", "description": "@Table 'catalog'." },
				"schema": { "type": "string", "description": "@Table 'schema'." },
				"uniqueConstraints": {
					"type": "array",
					"items": { "$ref": "#/$defs/uniqueConstraint" }
				},
				"indexes": {
					"type": "array",
					"items": { "$ref": "#/$defs/index" }
				},
				"columns": {
					"type": "array",
					"items": { "$ref": "#/$defs/column" }
				},
				"manyToOnes": {
					"type": "array",
					"items": { "$ref": "#/$defs/manyToOne" }
				},
				"oneToManys": {
					"type": "array",
					"items": { "$ref": "#/$defs/oneToMany" }
				}
			}
		},
		"uniqueConstraint": {
			"type": "object",
			"additionalProperties": false,
			"required": [ "columnNames" ],
			"properties": {
				"name": { "type": "string", "description": "@UniqueConstraint 'name'." },
				"columnNames": {
					"type": "array",
					"items": { "type": "string" },
					"description": "@UniqueConstraint 'columnNames'."
				}
			}
		},
		"index": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"name": { "type": "string", "description": "@Index 'name'." },
				"columnList": { "type": "string", "description": "@Index 'columnList'." },
				"unique": { "type": "boolean", "description": "@Index 'unique'." }
			}
		},
		"manyToOne": {
			"type": "object",
			"additionalProperties": false,
			"description": "A @ManyToOne association: the owning side of a relationship, backed by a foreign-key @JoinColumn. The generated field's type is 'targetClassName' (another table's className, in the same package).",
			"required": [ "fieldName", "targetClassName" ],
			"properties": {
				"fieldName": { "type": "string", "minLength": 1, "description": "Java field name of the association." },
				"targetClassName": { "type": "string", "minLength": 1, "description": "className of the referenced entity (its simple name is used as the field type)." },
				"fetch": { "type": "string", "enum": [ "LAZY", "EAGER" ], "description": "@ManyToOne 'fetch' (jakarta.persistence.FetchType)." },
				"optional": { "type": "boolean", "description": "@ManyToOne 'optional'." },
				"joinColumn": { "$ref": "#/$defs/joinColumn" }
			}
		},
		"joinColumn": {
			"type": "object",
			"additionalProperties": false,
			"description": "The @JoinColumn of a @ManyToOne (the foreign-key column).",
			"properties": {
				"name": { "type": "string", "description": "@JoinColumn 'name' (the foreign-key column)." },
				"referencedColumnName": { "type": "string", "description": "@JoinColumn 'referencedColumnName' (the target primary-key column)." },
				"nullable": { "type": "boolean", "description": "@JoinColumn 'nullable'." },
				"unique": { "type": "boolean", "description": "@JoinColumn 'unique'." },
				"foreignKey": { "type": "string", "minLength": 1, "description": "The DB foreign-key constraint: the literal 'NO_CONSTRAINT' renders @ForeignKey(value = ConstraintMode.NO_CONSTRAINT) (typical for a projection-maintained read model); any other value renders @ForeignKey(name = <value>)." }
			}
		},
		"oneToMany": {
			"type": "object",
			"additionalProperties": false,
			"description": "A @OneToMany association: the inverse (collection) side of a relationship. Generates a 'List<targetClassName>' field, initialized to an empty list; 'mappedBy' is the field name of the owning @ManyToOne on the target.",
			"required": [ "fieldName", "targetClassName", "mappedBy" ],
			"properties": {
				"fieldName": { "type": "string", "minLength": 1, "description": "Java field name of the collection." },
				"targetClassName": { "type": "string", "minLength": 1, "description": "className of the element entity (its simple name is used as the List element type)." },
				"mappedBy": { "type": "string", "minLength": 1, "description": "@OneToMany 'mappedBy' - the owning @ManyToOne field name on the target entity." },
				"fetch": { "type": "string", "enum": [ "LAZY", "EAGER" ], "description": "@OneToMany 'fetch' (jakarta.persistence.FetchType)." },
				"orphanRemoval": { "type": "boolean", "description": "@OneToMany 'orphanRemoval'." },
				"cascade": {
					"type": "array",
					"items": { "type": "string", "enum": [ "ALL", "PERSIST", "MERGE", "REMOVE", "REFRESH", "DETACH" ] },
					"description": "@OneToMany 'cascade' (jakarta.persistence.CascadeType values)."
				}
			}
		},
		"column": {
			"type": "object",
			"additionalProperties": false,
			"required": [ "fieldName", "javaType" ],
			"properties": {
				"fieldName": { "type": "string", "minLength": 1, "description": "Java field name." },
				"javaType": { "type": "string", "minLength": 1, "description": "Java type of the field (simple name or fully qualified)." },
				"id": { "type": "boolean", "description": "Whether the field is annotated with @Id." },
				"name": { "type": "string", "description": "@Column 'name'." },
				"unique": { "type": "boolean", "description": "@Column 'unique'." },
				"nullable": { "type": "boolean", "description": "@Column 'nullable'." },
				"insertable": { "type": "boolean", "description": "@Column 'insertable'." },
				"updatable": { "type": "boolean", "description": "@Column 'updatable'." },
				"columnDefinition": { "type": "string", "description": "@Column 'columnDefinition'." },
				"table": { "type": "string", "description": "@Column 'table'." },
				"length": { "type": "integer", "minimum": 0, "description": "@Column 'length'." },
				"precision": { "type": "integer", "minimum": 0, "description": "@Column 'precision'." },
				"scale": { "type": "integer", "minimum": 0, "description": "@Column 'scale'." },
				"digits": { "$ref": "#/$defs/digits" },
				"decimalMin": { "$ref": "#/$defs/decimalMin" }
			}
		},
		"digits": {
			"type": "object",
			"additionalProperties": false,
			"description": "@Digits bean-validation constraint.",
			"properties": {
				"integer": { "type": "integer", "minimum": 0, "description": "@Digits 'integer'." },
				"fraction": { "type": "integer", "minimum": 0, "description": "@Digits 'fraction'." }
			}
		},
		"decimalMin": {
			"type": "object",
			"additionalProperties": false,
			"required": [ "value" ],
			"description": "@DecimalMin bean-validation constraint (the value is a string, as in JPA).",
			"properties": {
				"value": { "type": "string", "minLength": 1, "description": "@DecimalMin 'value'." },
				"inclusive": { "type": "boolean", "description": "@DecimalMin 'inclusive'." }
			}
		}
	}
}
